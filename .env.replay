# Role configuration the committed cassettes (.adversary/cassettes) were recorded with.
# Loaded automatically in ADVERSARY_LLM_MODE=replay, or when no API key is set at all, so a clean
# clone replays the demo offline with the same models the verdicts name. Never overrides a set variable.
ADVERSARY_IMPLEMENTER_PROVIDER=meta
ADVERSARY_IMPLEMENTER_MODEL=muse-wonder-1.0
ADVERSARY_VERIFIER_PROVIDER=meta
ADVERSARY_VERIFIER_MODEL=muse-spark-1.3
ADVERSARY_JUDGE_PROVIDER=meta
ADVERSARY_JUDGE_MODEL=muse-spark-1.3
